# SecureAI Labs — Backend Environment Variables
# ================================================
# Copy this file, keep it private, never share it

SECRET_KEY=secureailabs-secret-key-change-this-2026

# Email settings (Gmail example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=info@secureailabs.org
MAIL_PASSWORD=your-email-app-password-here
MAIL_DEFAULT_SENDER=info@secureailabs.org
ADMIN_EMAIL=info@secureailabs.org

# Upload settings
MAX_UPLOAD_MB=16
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,mp4,pdf

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
